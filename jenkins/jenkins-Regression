// UBR stability regression. GUI only, so it can run off the automation testbed.
// Pick the stand, enter the BTS IP, and enter a CPE IP only when the link should be timed.

def archiveBuildArtifacts(pattern, allowEmpty = false) {
    step([
        $class: 'ArtifactArchiver',
        artifacts: pattern,
        fingerprint: true,
        onlyIfSuccessful: false,
        allowEmptyArchive: allowEmpty,
    ])
}

def selectedTests() {
    def raw = params.TESTS
    def text = raw == null ? '' : raw.toString()
    text = text.replace('[', '').replace(']', '')
    return text.split(',').collect { it.trim() }.findAll { it }
}

def cycleCount(String name) {
    def text = (params[name] ?: '').toString().trim()
    if (!(text ==~ /[1-9][0-9]*/)) {
        error("${name} must be a whole number, 1 or more.")
    }
    return text
}

def addressOf(String name, boolean required) {
    def text = (params[name] ?: '').toString().trim()
    if (!text) {
        if (required) {
            error('BTS IP is required. The test does not start without it.')
        }
        return ''
    }
    def ipv4 = text ==~ /^(?:[0-9]{1,3}\.){3}[0-9]{1,3}$/
    def ipv6 = text.contains(':') && (text ==~ /[0-9A-Fa-f:]+/)
    if (!ipv4 && !ipv6) {
        error("${name} must be an IPv4 or IPv6 address, got: ${text}")
    }
    if (ipv4 && text.split('\\.').any { (it as int) > 255 }) {
        error("${name} is not a valid IPv4 address: ${text}")
    }
    return text
}

properties([
    disableConcurrentBuilds(),
    parameters([
        [
            $class: 'ChoiceParameterDefinition',
            name: 'Target stand',
            choices: "test-qa-lab-01\ntest-qa-lab-02\ntest-harman2\ntest-a60-lab",
            description: ''
        ],
        [
            $class: 'StringParameterDefinition',
            name: 'BTS IP',
            defaultValue: '',
            description: ''
        ],
        [
            $class: 'StringParameterDefinition',
            name: 'CPE IP',
            defaultValue: '',
            description: ''
        ],
        [
            $class: 'ChoiceParameter',
            choiceType: 'PT_CHECKBOX',
            description: '',
            filterLength: 1,
            filterable: false,
            name: 'TESTS',
            randomName: 'reg-tests',
            script: [
                $class: 'GroovyScript',
                fallbackScript: [
                    $class: 'SecureGroovyScript',
                    sandbox: true,
                    script: 'return []'
                ],
                script: [
                    $class: 'SecureGroovyScript',
                    sandbox: true,
                    script: 'return ["REG_01":"Soft reboot ( ~5m each ):selected","REG_02":"Network soft reset ( ~3m each )","REG_03":"Firmware upgrade ( ~10m each )"]'
                ]
            ]
        ],
        [
            $class: 'StringParameterDefinition',
            name: 'Soft reboot cycles',
            defaultValue: '3',
            description: ''
        ],
        [
            $class: 'StringParameterDefinition',
            name: 'Network reset cycles',
            defaultValue: '3',
            description: ''
        ],
        [
            $class: 'StringParameterDefinition',
            name: 'Firmware cycles',
            defaultValue: '1',
            description: ''
        ],
        [
            $class: 'FileParameterDefinition',
            name: 'Firmware image',
            description: ''
        ],
        [
            $class: 'DynamicReferenceParameter',
            choiceType: 'ET_FORMATTED_HIDDEN_HTML',
            description: '',
            name: 'REG_LAYOUT',
            omitValueField: true,
            randomName: 'reg-layout',
            referencedParameters: '',
            script: [
                $class: 'GroovyScript',
                fallbackScript: [
                    $class: 'SecureGroovyScript',
                    sandbox: false,
                    script: 'return ""'
                ],
                script: [
                    $class: 'SecureGroovyScript',
                    sandbox: false,
                    script: '''return """<style>
#ecp_reg-tests {
  float: none !important;
  overflow: visible !important;
  height: auto !important;
  width: 100% !important;
  max-height: none !important;
}
.jenkins-form-item:has(#ecp_reg-tests) .active-choice,
.jenkins-form-item:has(#ecp_reg-tests) .setting-main { width: 100% !important; align-items: stretch !important; }
#ecp_reg-tests > div, #ecp_reg-tests > table {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(180px, 1fr));
  column-gap: 28px;
  row-gap: 8px;
  width: 100% !important;
}
#ecp_reg-tests .tr { white-space: normal !important; }
.jenkins-form-item:has(input[name="name"][value="REG_LAYOUT"]) { display: none !important; }
#reg-selection-summary { font-size: 15px; line-height: 1.45; padding: 8px 0 4px; }
</style>
<script>
(function () {
  var EACH = {REG_01: 5, REG_02: 3, REG_03: 10};
  var CYCLES = {REG_01: "Soft reboot cycles", REG_02: "Network reset cycles", REG_03: "Firmware cycles"};
  var LABELS = {REG_01: "Soft reboot", REG_02: "Network soft reset", REG_03: "Firmware upgrade"};
  function row(name) {
    var hidden = document.querySelector('input[name="name"][value="' + name + '"]');
    return hidden ? hidden.closest(".jenkins-form-item") : null;
  }
  function input(name) {
    var item = row(name);
    return item ? item.querySelector("input.jenkins-input") : null;
  }
  function format(mins) {
    var h = Math.floor(mins / 60);
    var m = mins % 60;
    if (h > 0) return m ? "~" + h + "h " + m + "m" : "~" + h + "h";
    return "~" + m + "m";
  }
  function sync() {
    var picked = {};
    document.querySelectorAll("#ecp_reg-tests input[type=checkbox]").forEach(function (el) {
      if (el.checked) picked[el.value] = true;
    });
    var cycles = 0;
    var mins = 0;
    var names = [];
    Object.keys(CYCLES).forEach(function (id) {
      var on = !!picked[id];
      var item = row(CYCLES[id]);
      if (item) item.style.display = on ? "" : "none";
      if (id === "REG_03") {
        var fileRow = row("Firmware image");
        if (fileRow) fileRow.style.display = on ? "" : "none";
      }
      if (!on) return;
      var field = input(CYCLES[id]);
      var n = field ? parseInt(field.value, 10) : 1;
      if (!n || n < 1) n = 1;
      cycles += n;
      mins += n * EACH[id];
      names.push(LABELS[id] + " × " + n);
    });
    var bar = document.getElementById("reg-selection-summary");
    if (!bar) {
      bar = document.createElement("div");
      bar.id = "reg-selection-summary";
      var button = document.querySelector("button.jenkins-button--primary");
      var host = button ? button.parentNode : null;
      if (host && host.parentNode) host.parentNode.insertBefore(bar, host);
    }
    if (!names.length) {
      bar.innerHTML = '<span style="color:#667">Tick the tests above. The total updates here, then press Build.</span>';
      return;
    }
    bar.innerHTML = '<strong>' + cycles + ' cycles</strong> &nbsp;·&nbsp; <strong>' + format(mins) + '</strong><div style="color:#5f6b76;margin-top:2px">' + names.join(', ') + '</div>';
  }
  document.addEventListener("change", sync);
  document.addEventListener("input", sync);
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", sync);
  else sync();
})();
</script>"""'''
                ]
            ]
        ]
    ])
])

pipeline {
    agent { label "${params['Target stand'] ?: 'test-qa-lab-01'}" }

    options {
        disableConcurrentBuilds()
    }

    environment {
        TARGET_STAND = "${params['Target stand'] ?: 'test-qa-lab-01'}"
    }

    stages {
        stage('Prepare regression') {
            steps {
                script {
                    def order = ['REG_01', 'REG_02', 'REG_03']
                    def picked = selectedTests()
                    def unknown = picked.findAll { !order.contains(it) }
                    if (!unknown.isEmpty()) {
                        error("Unknown regression test: ${unknown.join(', ')}")
                    }
                    def selected = order.findAll { picked.contains(it) }
                    if (selected.isEmpty()) {
                        error('Tick at least one test.')
                    }
                    def btsIp = addressOf('BTS IP', true)
                    def cpeIp = addressOf('CPE IP', false)
                    if (selected.contains('REG_03') && !(params['Firmware image'] ?: '').toString().trim()) {
                        error('Choose a firmware image when Firmware upgrade is ticked.')
                    }

                    def stand = (params['Target stand'] ?: 'test-qa-lab-01').toString().trim()
                    def bench = readFile('config/benches.yaml')
                    def profile = ''
                    def recovery = ''
                    def inStand = false
                    for (line in bench.readLines()) {
                        def trimmed = line.trim()
                        if (line.startsWith('  ') && !line.startsWith('    ') && trimmed.endsWith(':')) {
                            inStand = trimmed == "${stand}:"
                            continue
                        }
                        if (!inStand) {
                            continue
                        }
                        if (trimmed.startsWith('profile:')) {
                            profile = trimmed.substring('profile:'.length()).trim()
                        }
                        if (trimmed.startsWith('recovery_profile:')) {
                            recovery = trimmed.substring('recovery_profile:'.length()).trim()
                        }
                    }
                    if (!profile || !recovery) {
                        error("config/benches.yaml has no profile for ${stand}")
                    }

                    def summary = []
                    def iterArgs = []
                    if (selected.contains('REG_01')) {
                        def n = cycleCount('Soft reboot cycles')
                        summary << "Soft reboot × ${n}"
                        iterArgs << "--regression-iterations-reg01 ${n}"
                    }
                    if (selected.contains('REG_02')) {
                        def n = cycleCount('Network reset cycles')
                        summary << "Network soft reset × ${n}"
                        iterArgs << "--regression-iterations-reg02 ${n}"
                    }
                    if (selected.contains('REG_03')) {
                        def n = cycleCount('Firmware cycles')
                        summary << "Firmware upgrade × ${n}"
                        iterArgs << "--regression-iterations-reg03 ${n}"
                        def uploadedName = params['Firmware image'].toString().trim()
                        def uploadedPath = "${env.WORKSPACE}/${uploadedName}"
                        sh """
                            mkdir -p uploads
                            cp \"${uploadedPath}\" uploads/firmware_upload.bin
                        """
                        env.FIRMWARE_IMAGE_ARG = '--firmware-image uploads/firmware_upload.bin'
                    } else {
                        env.FIRMWARE_IMAGE_ARG = ''
                    }

                    env.REGRESSION_SELECTED_SUMMARY = summary.join(', ')
                    env.REGRESSION_K_FILTER = selected.join(' or ')
                    env.REGRESSION_ITER_ARGS = iterArgs.join(' ')
                    env.PROFILE_NAME = profile
                    env.RECOVERY_PROFILE_NAME = recovery
                    env.REGRESSION_BTS_IP = btsIp
                    env.REGRESSION_CPE_IP = cpeIp
                    env.REGRESSION_CPE_ARG = cpeIp ? "--regression-cpe-ip '${cpeIp}'" : ''

                    echo '----------------------------------------'
                    echo 'UBR Stability Regression'
                    echo "Agent:          ${stand}"
                    echo "BTS IP:         ${btsIp}"
                    echo "CPE IP:         ${cpeIp ?: '(not set — local BTS ping only)'}"
                    echo "Tests:          ${env.REGRESSION_SELECTED_SUMMARY}"
                    echo "Profile:        ${env.PROFILE_NAME}"
                    echo "Recovery:       ${env.RECOVERY_PROFILE_NAME}"
                    echo "Firmware:       ${selected.contains('REG_03') ? 'uploaded image -> uploads/firmware_upload.bin' : '(not used)'}"
                    echo 'Report:         reports/artifacts/Regression_Report.html'
                    echo '----------------------------------------'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    bash jenkins/ensure-system-deps.sh

                    python3 -m venv venv
                    venv/bin/pip install --upgrade pip
                    venv/bin/pip install -r requirements.txt
                    venv/bin/playwright install chromium
                '''
            }
        }

        stage('Execute Regression Suite') {
            steps {
                script {
                    sh '''
                        rm -f reports/artifacts/regression_collector_state.json \
                              reports/artifacts/Regression_Report.html \
                              reports/artifacts/regression_pytest.html \
                              Senao_Regression_*.html || true
                    '''

                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        sh """
                            export PYTHONUNBUFFERED=1
                            export PYTHONPATH=.
                            stdbuf -oL -eL venv/bin/python -u -m pytest tests/Regression/ -v \
                            -k "${env.REGRESSION_K_FILTER}" \
                            --allow-regression \
                            --regression-fresh \
                            --profile "${env.PROFILE_NAME}" \
                            --recovery-profile "${env.RECOVERY_PROFILE_NAME}" \
                            --skip-testbed-bootstrap \
                            --regression-bts-ip "${env.REGRESSION_BTS_IP}" \
                            ${env.REGRESSION_CPE_ARG} \
                            ${env.REGRESSION_ITER_ARGS} \
                            ${env.FIRMWARE_IMAGE_ARG}
                        """
                    }
                }
            }
        }

        stage('Finalize Report') {
            steps {
                script {
                    def senao = load 'jenkins/jenkins-common.groovy'
                    def destFile = "${senao.standardReportBasename('Senao_Regression')}.html"
                    try {
                        senao.copyRegressionReport(destFile)
                        env.REGRESSION_REPORT = destFile
                    } catch (Exception exc) {
                        unstable("Regression HTML report not produced: ${exc.message}")
                    }
                }
            }
        }

        stage('Archive Report') {
            steps {
                script {
                    archiveBuildArtifacts('Senao_Regression_*.html', true)
                    archiveBuildArtifacts('reports/artifacts/Regression_Report.html', true)
                    archiveBuildArtifacts('reports/artifacts/regression_pytest.html', true)
                }
            }
        }
    }

    post {
        always {
            script {
                def senao = load 'jenkins/jenkins-common.groovy'
                def destFile = env.REGRESSION_REPORT ?: "${senao.standardReportBasename('Senao_Regression')}.html"
                def hasReport = fileExists(destFile)

                if (hasReport) {
                    senao.publishSenaoHtmlReport(destFile, "Senao Regression Report - Build ${env.BUILD_NUMBER}")
                }

                def detailsHtml = """\
                    <p><strong>Tests run:</strong> ${env.REGRESSION_SELECTED_SUMMARY ?: '—'}</p>
                    <p><strong>Stand:</strong> ${env.TARGET_STAND ?: '—'}</p>
                    <p><strong>BTS IP:</strong> ${env.REGRESSION_BTS_IP ?: '—'}</p>
                    <p><strong>CPE IP:</strong> ${env.REGRESSION_CPE_IP ?: 'not set — local BTS ping only'}</p>
                    <p><strong>Firmware:</strong> ${env.FIRMWARE_IMAGE_ARG ? 'uploaded in build' : '(not used)'}</p>
                    <p><strong>Report:</strong> one merged HTML (per test: Total Executed / Passed / Failed)</p>
                """

                try {
                    senao.sendSenaoPipelineEmail([
                        subjectPrefix: 'UBR Stability Regression',
                        reportTitle: 'UBR Stability Regression Report',
                        footerNote: 'Merged regression results per test type',
                        reportFile: hasReport ? destFile : '',
                        detailsHtml: detailsHtml
                    ])
                } catch (Exception exc) {
                    echo "Email notification failed: ${exc.message}"
                }
            }
        }
    }
}
