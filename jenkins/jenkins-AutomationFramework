// UBR GUI test cases — runs on TARGET_STAND.
// Report: Senao_GUI_<build>_Report_<date>.html + CSV (hero + testbed summary + test results).

def archiveArtifacts(pattern) {
    step([$class: 'ArtifactArchiver', artifacts: pattern, fingerprint: true, onlyIfSuccessful: false])
}

pipeline {
    agent { node { label "${TARGET_STAND}" } }

    parameters {
        string(
            name: 'TEST_FILTER',
            defaultValue: 'Summary, TopPanel, WirelessProperties',
            description: 'Pytest -k filter (comma-separated keywords, e.g. GUI_05, WirelessProperties)'
        )
        string(
            name: 'Local IPv6 Address',
            defaultValue: '',
            description: 'BTS IPv6. Leave empty to use profiles/<PROFILE_NAME>.yaml default'
        )
        string(
            name: 'PROFILE_NAME',
            defaultValue: 'default',
            description: 'Primary profile: profiles/<name>.yaml'
        )
        string(
            name: 'RECOVERY_PROFILE_NAME',
            defaultValue: 'link_formation',
            description: 'Recovery profile: profiles/<name>.yaml'
        )
        booleanParam(
            name: 'ENABLE_DESTRUCTIVE_JUMBO',
            defaultValue: false,
            description: 'Allow destructive jumbo tests (JMB_07/JMB_10) when filter includes JumboFrames'
        )
    }

    stages {
        stage('Prepare tests') {
            steps {
                script {
                    echo '----------------------------------------'
                    echo 'UBR GUI Test Cases (pytest)'
                    echo "--- TARGET STAND: ${TARGET_STAND}"
                    echo "--- TEST FILTER:  ${params.TEST_FILTER}"
                    echo "Local IPv6:     ${params['Local IPv6 Address'] ?: '(profile default)'}"
                    echo "Profile:        ${params.PROFILE_NAME}"
                    echo '----------------------------------------'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    python3 -m venv venv
                    venv/bin/pip install --upgrade pip
                    venv/bin/pip install -r requirements.txt
                    venv/bin/playwright install chromium
                '''
            }
        }

        stage('Execute Pytest Suite') {
            steps {
                script {
                    def localIP = (params['Local IPv6 Address'] ?: '').trim()
                    def profileName = params.PROFILE_NAME
                    def recoveryProfileName = params.RECOVERY_PROFILE_NAME
                    def destructiveFlag = params.ENABLE_DESTRUCTIVE_JUMBO ? '--allow-destructive-jumbo' : ''
                    def formattedFilter = params.TEST_FILTER.split(',')
                        .collect { it.trim() }
                        .findAll { it }
                        .join(' or ')
                    def ipv6Arg = localIP ? "--local-ipv6 \"${localIP}\"" : ''

                    echo "Testing with filter: [ ${formattedFilter} ]"
                    sh 'rm -f reports/artifacts/report.json reports/artifacts/testbed_summary.json reports/artifacts/Senao_GUI_*.html reports/artifacts/Senao_GUI_*.csv Senao_GUI_*.html Senao_GUI_*.csv || true'

                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        sh """
                            PYTHONPATH=. venv/bin/python -m pytest tests/GUI/ -v -k "${formattedFilter}" \
                            --profile "${profileName}" \
                            --recovery-profile "${recoveryProfileName}" \
                            ${ipv6Arg} \
                            ${destructiveFlag} \
                            --json-report --json-report-file=reports/artifacts/report.json
                        """
                    }
                }
            }
        }

        stage('Generate Customer Report') {
            steps {
                script {
                    def senao = load 'jenkins/jenkins-common.groovy'
                    def localIP = (params['Local IPv6 Address'] ?: 'profile-default').trim()
                    def basename = senao.standardReportBasename('Senao_GUI')
                    def htmlFile = "reports/artifacts/${basename}.html"
                    def csvFile = "reports/artifacts/${basename}.csv"

                    if (!fileExists('reports/artifacts/report.json')) {
                        unstable('reports/artifacts/report.json missing — skipping report generation')
                        return
                    }

                    echo 'Building Senao GUI HTML & CSV (report_generator.py)...'
                    sh "PYTHONPATH=. venv/bin/python utils/report_generator.py ${env.BUILD_ID} ${localIP} ${new Date().format('yyyyMMdd')} --profile ${params.PROFILE_NAME} --output-prefix Senao_GUI"

                    if (!fileExists(htmlFile)) {
                        error("Customer report not created: ${htmlFile}")
                    }
                    env.CUSTOMER_REPORT = htmlFile
                    env.CUSTOMER_REPORT_CSV = csvFile
                    echo "GUI report: ${htmlFile}"
                }
            }
        }

        stage('Archive Report') {
            steps {
                archiveArtifacts 'reports/artifacts/Senao_GUI_*.html'
                archiveArtifacts 'reports/artifacts/Senao_GUI_*.csv,allowEmptyArchive:true'
                archiveArtifacts 'reports/artifacts/report.json,allowEmptyArchive:true'
                archiveArtifacts 'reports/artifacts/testbed_summary.json,allowEmptyArchive:true'
            }
        }
    }

    post {
        always {
            script {
                def senao = load 'jenkins/jenkins-common.groovy'
                def basename = senao.standardReportBasename('Senao_GUI')
                def htmlFile = env.CUSTOMER_REPORT ?: "reports/artifacts/${basename}.html"
                def csvFile = env.CUSTOMER_REPORT_CSV ?: "reports/artifacts/${basename}.csv"
                def hasReport = fileExists(htmlFile)

                if (hasReport) {
                    senao.publishSenaoHtmlReport(htmlFile, "Senao GUI Test Report - Build ${env.BUILD_NUMBER}")
                }

                def detailsHtml = """\
                    <p><strong>Test filter:</strong> ${params.TEST_FILTER}</p>
                    <p><strong>Target IPv6:</strong> ${params['Local IPv6 Address'] ?: '(profile default)'}</p>
                    <p><strong>Profile:</strong> ${params.PROFILE_NAME}</p>
                    <p><strong>Recovery profile:</strong> ${params.RECOVERY_PROFILE_NAME}</p>
                    <p><strong>Destructive jumbo:</strong> ${params.ENABLE_DESTRUCTIVE_JUMBO}</p>
                """

                try {
                    senao.sendSenaoPipelineEmail([
                        subjectPrefix: 'UBR GUI Test Cases',
                        reportTitle: 'Senao UBR Validation Execution Report',
                        footerNote: 'GUI vs SSH validation with BTS/CPE testbed summary',
                        reportFile: hasReport ? htmlFile : '',
                        csvFile: fileExists(csvFile) ? csvFile : '',
                        detailsHtml: detailsHtml
                    ])
                } catch (Exception exc) {
                    echo "Email notification failed: ${exc.message}"
                }
            }
        }
    }
}
