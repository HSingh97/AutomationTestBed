// Automation Test Cases — qa-lab-01 only.
// Tick the suites to run. Addresses, profile, and recovery come from
// config/benches.yaml (test-qa-lab-01). Recovery uses only
// config/backup-UBR650-bts.tar.gz and config/backup-UBR650-cpe.tar.gz.
// CPU utilization and regression stay on their own jobs.

def archiveBuildArtifacts(pattern, allowEmpty = false) {
    step([
        $class: 'ArtifactArchiver',
        artifacts: pattern,
        fingerprint: true,
        onlyIfSuccessful: false,
        allowEmptyArchive: allowEmpty,
    ])
}

def selectedSuites() {
    def raw = params.SUITES
    def text = raw == null ? '' : raw.toString()
    text = text.replace('[', '').replace(']', '')
    return text.split(',').collect { it.trim() }.findAll { it }
}

properties([
    disableConcurrentBuilds(),
    parameters([
        [
            $class: 'ChoiceParameter',
            choiceType: 'PT_CHECKBOX',
            description: '',
            filterLength: 1,
            filterable: false,
            name: 'SUITES',
            randomName: 'suites-checkbox',
            script: [
                $class: 'GroovyScript',
                fallbackScript: [
                    $class: 'SecureGroovyScript',
                    sandbox: true,
                    script: 'return []'
                ],
                script: [
                    $class: 'SecureGroovyScript',
                    sandbox: true,
                    script: 'return ["GUI":"GUI ( 73 ) ( ~2h 30m )","IP":"IP ( 35 ) ( ~1h 15m )","JUMBO":"JUMBO ( 10 ) ( ~25m )","QOS":"QOS ( 32 ) ( ~1h )","USERMGMT":"USERMGMT ( 50 ) ( ~2h )","VLAN":"VLAN ( 44 ) ( ~1h 20m )","LOGS":"LOGS ( 72 ) ( ~1h 10m )","FIREWALL":"FIREWALL ( 6 ) ( ~15m )","DFS":"DFS ( 21 ) ( ~45m )","SECURITY":"SECURITY ( 13 ) ( ~30m )","ACB":"ACB ( 8 ) ( ~25m )","WIRELESS":"WIRELESS ( 8 ) ( ~40m )","ARP":"ARP ( 11 ) ( ~20m )","API":"API ( 18 ) ( ~35m )","RADIO24":"RADIO24 ( 14 ) ( ~35m )","SANITY":"SANITY ( 47 ) ( ~1h 40m )","DDRS":"DDRS ( 49 ) ( ~2h )","DHCP":"DHCP ( 42 ) ( ~1h 30m )","FUNCTIONAL":"FUNCTIONAL ( 25 ) ( ~1h )","LINKTEST":"LINKTEST ( 14 ) ( ~30m )","SPECTRUM":"SPECTRUM ( 22 ) ( ~40m )"]'
                ]
            ]
        ],
        [
            $class: 'DynamicReferenceParameter',
            choiceType: 'ET_FORMATTED_HTML',
            description: '',
            name: 'SELECTED',
            omitValueField: true,
            randomName: 'suite-total',
            referencedParameters: 'SUITES',
            script: [
                $class: 'GroovyScript',
                fallbackScript: [
                    $class: 'SecureGroovyScript',
                    sandbox: true,
                    script: '''return '<div style="padding:6px 0;color:#667;">Tick the suites above. The total updates here, then press Build.</div>' '''
                ],
                script: [
                    $class: 'SecureGroovyScript',
                    sandbox: true,
                    script: '''def counts = [GUI:73, IP:35, JUMBO:10, QOS:32, USERMGMT:50, VLAN:44, LOGS:72, FIREWALL:6, DFS:21, SECURITY:13, ACB:8, WIRELESS:8, ARP:11, API:18, RADIO24:14, SANITY:47, DDRS:49, DHCP:42, FUNCTIONAL:25, LINKTEST:14, SPECTRUM:22]
def minutes = [GUI:150, IP:75, JUMBO:25, QOS:60, USERMGMT:120, VLAN:80, LOGS:70, FIREWALL:15, DFS:45, SECURITY:30, ACB:25, WIRELESS:40, ARP:20, API:35, RADIO24:35, SANITY:100, DDRS:120, DHCP:90, FUNCTIONAL:60, LINKTEST:30, SPECTRUM:40]
def raw = ""
try { raw = SUITES == null ? "" : SUITES.toString() } catch (Exception e) { raw = "" }
def names = raw.split(",").collect { it.trim() }.findAll { it && counts.containsKey(it) }
if (!names) {
  return '<div style="padding:6px 0;color:#667;">Tick the suites above. The total updates here, then press Build.</div>'
}
int cases = 0
int mins = 0
names.each { n -> cases += (counts[n] as int); mins += (minutes[n] as int) }
int h = (int) (mins / 60)
int rem = mins % 60
def time = h > 0 ? (rem > 0 ? "~" + h + "h " + rem + "m" : "~" + h + "h") : "~" + rem + "m"
return '<div style="font-size:15px;line-height:1.45;padding:4px 0;"><strong>' + cases + ' cases</strong> &nbsp;&middot;&nbsp; <strong>' + time + '</strong><div style="color:#5f6b76;margin-top:2px;">' + names.join(", ") + '</div></div>' '''
                ]
            ]
        ],
        [
            $class: 'DynamicReferenceParameter',
            choiceType: 'ET_FORMATTED_HIDDEN_HTML',
            description: '',
            name: 'SUITE_LAYOUT',
            omitValueField: true,
            randomName: 'suite-layout',
            referencedParameters: '',
            script: [
                $class: 'GroovyScript',
                fallbackScript: [
                    $class: 'SecureGroovyScript',
                    sandbox: false,
                    script: 'return ""'
                ],
                script: [
                    $class: 'SecureGroovyScript',
                    sandbox: false,
                    script: '''return """<style>
#ecp_suites-checkbox {
  float: none !important;
  overflow: visible !important;
  height: auto !important;
  width: 100% !important;
  max-height: none !important;
}
.jenkins-form-item:has(#ecp_suites-checkbox) .active-choice,
.jenkins-form-item:has(#ecp_suites-checkbox) .setting-main {
  width: 100% !important;
  align-items: stretch !important;
}
#ecp_suites-checkbox > div, #ecp_suites-checkbox > table {
  display: grid !important;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  column-gap: 28px;
  row-gap: 6px;
  width: 100% !important;
}
#ecp_suites-checkbox .tr { white-space: normal !important; }
.jenkins-form-item:has(input[name="name"][value="SUITE_LAYOUT"]) { display: none !important; }
</style>"""'''
                ]
            ]
        ]
    ])
])

pipeline {
    agent { label 'test-qa-lab-01' }

    options {
        disableConcurrentBuilds()
    }

    environment {
        TARGET_STAND = 'test-qa-lab-01'
    }

    stages {
        stage('Prepare tests') {
            steps {
                script {
                    def order = [
                        'GUI', 'IP', 'JUMBO', 'QOS', 'USERMGMT',
                        'VLAN', 'LOGS', 'FIREWALL', 'DFS', 'SECURITY', 'ACB', 'WIRELESS',
                        'ARP', 'API', 'RADIO24', 'SANITY', 'DDRS', 'DHCP', 'FUNCTIONAL',
                        'LINKTEST', 'SPECTRUM',
                    ]
                    def picked = selectedSuites()
                    def selected = order.findAll { picked.contains(it) }
                    def unknown = picked.findAll { !order.contains(it) }
                    if (!unknown.isEmpty()) {
                        error("Unknown suite: ${unknown.join(', ')}")
                    }
                    if (selected.isEmpty()) {
                        error('Tick at least one suite. Addresses are taken from the qa-lab-01 bench profile.')
                    }
                    def bench = readFile('config/benches.yaml')
                    def profile = ''
                    def recovery = ''
                    def inStand = false
                    for (line in bench.readLines()) {
                        def trimmed = line.trim()
                        if (line.startsWith('  ') && !line.startsWith('    ') && trimmed.endsWith(':')) {
                            inStand = trimmed == 'test-qa-lab-01:'
                            continue
                        }
                        if (!inStand) {
                            continue
                        }
                        if (line.startsWith('  ') && !line.startsWith('    ') && trimmed.endsWith(':')) {
                            break
                        }
                        if (trimmed.startsWith('profile:')) {
                            profile = trimmed.substring('profile:'.length()).trim()
                        }
                        if (trimmed.startsWith('recovery_profile:')) {
                            recovery = trimmed.substring('recovery_profile:'.length()).trim()
                        }
                    }
                    if (!profile || !recovery) {
                        error('config/benches.yaml has no profile for test-qa-lab-01')
                    }
                    env.SUITES = selected.join(',')
                    env.PROFILE_NAME = profile
                    env.RECOVERY_PROFILE_NAME = recovery
                    echo '----------------------------------------'
                    echo 'Automation Test Cases'
                    echo 'Agent:          test-qa-lab-01'
                    echo "Suites:         ${env.SUITES}"
                    echo "Profile:        ${env.PROFILE_NAME}"
                    echo "Recovery:       ${env.RECOVERY_PROFILE_NAME}"
                    echo 'Backups:        config/backup-UBR650-bts.tar.gz, config/backup-UBR650-cpe.tar.gz'
                    echo '----------------------------------------'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    bash jenkins/ensure-system-deps.sh
                    python3 -m venv venv
                    venv/bin/pip install --upgrade pip
                    venv/bin/pip install -r requirements.txt
                    venv/bin/playwright install chromium
                '''
            }
        }

        stage('Restore from backup') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh '''
                        export PYTHONUNBUFFERED=1
                        export PYTHONPATH=.
                        venv/bin/python scripts/bootstrap_testbed.py \
                          --profile "${PROFILE_NAME}" \
                          --recovery-profile "${RECOVERY_PROFILE_NAME}" \
                          --restore-archives
                    '''
                }
            }
        }

        stage('Execute selected suites') {
            steps {
                sh '''
                    rm -f reports/artifacts/report.json reports/artifacts/ip_suite_progress.json \
                          reports/artifacts/testbed_summary.json \
                          reports/artifacts/Senao_UBR_*.html reports/artifacts/Senao_UBR_*.csv \
                          Senao_UBR_*.html || true
                '''
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh '''
                        export PYTHONUNBUFFERED=1
                        export PYTHONPATH=.
                        bash jenkins/run-selected-suites.sh
                    '''
                }
            }
        }

        stage('Restore after tests') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh '''
                        export PYTHONUNBUFFERED=1
                        export PYTHONPATH=.
                        venv/bin/python scripts/bootstrap_testbed.py \
                          --profile "${PROFILE_NAME}" \
                          --recovery-profile "${RECOVERY_PROFILE_NAME}" \
                          --restore-archives
                    '''
                }
            }
        }

        stage('Generate Customer Report') {
            steps {
                script {
                    def senao = load 'jenkins/jenkins-common.groovy'
                    def basename = senao.standardReportBasename('Senao_UBR')
                    def htmlFile = "reports/artifacts/${basename}.html"
                    def csvFile = "reports/artifacts/${basename}.csv"

                    if (!fileExists('reports/artifacts/report.json')) {
                        unstable('reports/artifacts/report.json missing — no suite results to publish')
                        return
                    }

                    sh "PYTHONPATH=. venv/bin/python utils/report_generator.py ${env.BUILD_ID} qa-lab-01 ${new Date().format('yyyyMMdd')} --profile ${env.PROFILE_NAME} --output-prefix Senao_UBR"

                    if (!fileExists(htmlFile)) {
                        error("Customer report not created: ${htmlFile}")
                    }
                    env.CUSTOMER_REPORT = htmlFile
                    env.CUSTOMER_REPORT_CSV = csvFile
                    echo "Report: ${htmlFile}"
                }
            }
        }

        stage('Archive Report') {
            steps {
                script {
                    archiveBuildArtifacts('reports/artifacts/Senao_UBR_*.html')
                    archiveBuildArtifacts('reports/artifacts/Senao_UBR_*.csv', true)
                    archiveBuildArtifacts('reports/artifacts/report.json', true)
                    archiveBuildArtifacts('reports/artifacts/suite_*.json', true)
                    archiveBuildArtifacts('reports/artifacts/ip_suite_progress.json', true)
                    archiveBuildArtifacts('reports/artifacts/testbed_summary.json', true)
                    archiveBuildArtifacts('reports/artifacts/jumbo_captures/**/*', true)
                    archiveBuildArtifacts('reports/artifacts/jumbo_captures_index.json', true)
                    archiveBuildArtifacts('reports/artifacts/sua*_queue_stats_*.csv', true)
                }
            }
        }
    }

    post {
        always {
            script {
                def senao = load 'jenkins/jenkins-common.groovy'
                def basename = senao.standardReportBasename('Senao_UBR')
                def htmlFile = env.CUSTOMER_REPORT ?: "reports/artifacts/${basename}.html"
                def csvFile = env.CUSTOMER_REPORT_CSV ?: "reports/artifacts/${basename}.csv"
                def hasReport = fileExists(htmlFile)
                if (hasReport) {
                    senao.publishSenaoHtmlReport(htmlFile, "Senao UBR Test Report - Build ${env.BUILD_NUMBER}")
                }
                def detailsHtml = """\
                    <p><strong>Agent:</strong> test-qa-lab-01</p>
                    <p><strong>Suites:</strong> ${env.SUITES ?: '(none)'}</p>
                    <p><strong>Profile:</strong> ${env.PROFILE_NAME ?: '(bench)'}</p>
                    <p><strong>Recovery archives:</strong> config/backup-UBR650-bts.tar.gz, config/backup-UBR650-cpe.tar.gz</p>
                """
                try {
                    senao.sendSenaoPipelineEmail([
                        subjectPrefix: 'UBR Validation',
                        reportTitle: 'Senao UBR Validation Execution Report',
                        footerNote: 'Suites ticked on qa-lab-01. Addresses come from the bench profile.',
                        reportFile: hasReport ? htmlFile : '',
                        csvFile: fileExists(csvFile) ? csvFile : '',
                        detailsHtml: detailsHtml
                    ])
                } catch (Exception exc) {
                    echo "Email notification failed: ${exc.message}"
                }
            }
        }
    }
}
