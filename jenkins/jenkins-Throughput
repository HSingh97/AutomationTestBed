pipeline {
    agent { label 'test-qa-lab-01' }

    options {
        disableConcurrentBuilds()
    }

    environment {
        TARGET_STAND = 'test-qa-lab-01'
    }

    stages {
        stage('Prepare Testbed') {
            steps {
                script {
                    def bandwidths = selectedValues('BANDWIDTH', ['HT20', 'HT40+', 'HT80', 'HT160'])
                    def mcsOrder = (0..23).collect { "MCS${it}" }
                    def mcsList = selectedValues('MCS', mcsOrder)
                    if (bandwidths.isEmpty() || mcsList.isEmpty()) {
                        error('Tick at least one bandwidth and one MCS. Addresses are taken from the qa-lab-01 bench profile.')
                    }
                    def packet = wholeNumber('Packet size')
                    def seconds = wholeNumber('Seconds each')
                    def suCount = wholeNumber('SU count')
                    def trexIp = (params['TRex server IP'] ?: '192.168.1.2').toString().trim()
                    if (!(trexIp ==~ /\d{1,3}(\.\d{1,3}){3}/)) {
                        error("TRex server IP must be an IPv4 address, got: ${trexIp}")
                    }
                    def ratio = (params['DL:UL ratio'] ?: '').toString().trim()
                    if (!(ratio ==~ /\d+:\d+/)) {
                        error("DL:UL ratio must look like 50:50, got: ${ratio}")
                    }
                    env.TPUT_BANDWIDTHS = bandwidths.join(',')
                    env.TPUT_MCS = mcsList.join(',')
                    env.TPUT_PACKET = packet
                    env.TPUT_SECONDS = seconds
                    env.TPUT_SU = suCount
                    env.TPUT_TREX = trexIp
                    env.TPUT_RATIO = ratio
                    echo '------------------------------------------'
                    echo 'UBR throughput per MCS (TRex matrix)'
                    echo 'Agent:       test-qa-lab-01'
                    echo "Bandwidth:   ${env.TPUT_BANDWIDTHS}"
                    echo "MCS:         ${mcsList.size()} rates"
                    echo "Packet:      ${packet}"
                    echo "Ratio:       ${ratio}"
                    echo "Duration:    ${seconds}s"
                    echo "SU count:    ${suCount}"
                    echo "TRex server: ${trexIp}"
                    echo 'Radio:       qa-lab-01 bench profile'
                    echo '------------------------------------------'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    bash jenkins/ensure-system-deps.sh

                    python3 -m venv venv
                    venv/bin/pip install --upgrade pip
                    venv/bin/pip install -r requirements.txt
                '''
            }
        }

        stage('Run Performance Matrix') {
            steps {
                script {
                    sh 'rm -rf reports/artifacts/performance_* reports/artifacts/Performance_Report_*.html Senao_Performance_*.html || true'

                    def cmd = new StringBuilder('PYTHONPATH=. venv/bin/python traffic/performance_matrix.py')
                    cmd.append(" --bandwidths '${env.TPUT_BANDWIDTHS}'")
                    cmd.append(" --mcs '${env.TPUT_MCS}'")
                    cmd.append(" --ratios '${env.TPUT_RATIO}'")
                    cmd.append(' --ratios-only')
                    cmd.append(' --no-fail-on-rate-mismatch')
                    cmd.append(" --time ${env.TPUT_SECONDS}")
                    cmd.append(" --packet-size ${env.TPUT_PACKET}")
                    cmd.append(' --su-link-wait-s 180')
                    cmd.append(' --bandwidth-apply-wait-s 60')
                    cmd.append(' --bandwidth-running-wait-s 20')
                    cmd.append(' --operating-mcs-wait-s 45')
                    cmd.append(' --deploy-client-script')
                    cmd.append(" --stand 'test-qa-lab-01'")
                    cmd.append(" --su-count ${env.TPUT_SU}")
                    cmd.append(" --trex-server '${env.TPUT_TREX}'")

                    def exitCode = sh(script: cmd.toString(), returnStatus: true)
                    env.PERF_MATRIX_EXIT = "${exitCode}"

                    def reportPath = sh(
                        script: '''
                            set -e
                            latest=$(ls -t reports/artifacts/Performance_Report_*_Grafana.html 2>/dev/null | head -1 || true)
                            if [ -z "$latest" ]; then
                              latest=$(ls -t reports/artifacts/Performance_Report_*.html 2>/dev/null | grep -v '_Grafana\\.html$' | head -1 || true)
                            fi
                            echo "$latest"
                        ''',
                        returnStdout: true
                    ).trim()
                    if (!reportPath) {
                        error('Performance matrix finished but no Grafana/classic HTML report found under reports/artifacts/')
                    }
                    env.PERFORMANCE_REPORT_RAW = reportPath
                    echo "HTML report (raw): ${reportPath}"
                    if (exitCode != 0) {
                        unstable("Performance matrix completed with failures (exit ${exitCode})")
                    }
                }
            }
        }

        stage('Finalize Report') {
            steps {
                script {
                    def senao = load 'jenkins/jenkins-common.groovy'
                    def destFile = "${senao.standardReportBasename('Senao_Performance')}.html"
                    senao.copyLatestPerformanceReport(destFile)
                    env.PERFORMANCE_REPORT = destFile
                    echo "Standard report: ${destFile}"
                }
            }
        }

        stage('Archive Report') {
            steps {
                script {
                    archiveBuildArtifacts('Senao_Performance_*.html')
                    archiveBuildArtifacts('reports/artifacts/Performance_Report_*.html', true)
                    archiveBuildArtifacts('reports/artifacts/performance_*/**', true)
                }
            }
        }
    }

    post {
        always {
            script {
                def senao = load 'jenkins/jenkins-common.groovy'
                def reportFile = env.PERFORMANCE_REPORT ?: "${senao.standardReportBasename('Senao_Performance')}.html"
                def hasReport = fileExists(reportFile)

                if (hasReport) {
                    senao.publishSenaoHtmlReport(reportFile, "Senao Performance Report - Build ${env.BUILD_NUMBER}")
                }

                def mcsCount = (env.TPUT_MCS ?: '').split(',').findAll { it.trim() }.size()
                def detailsHtml = """\
                    <p><strong>Bench:</strong> qa-lab-01</p>
                    <p><strong>Bandwidth:</strong> ${env.TPUT_BANDWIDTHS ?: '—'}</p>
                    <p><strong>MCS:</strong> ${mcsCount}</p>
                    <p><strong>Packet size:</strong> ${env.TPUT_PACKET ?: '—'} bytes</p>
                    <p><strong>DL:UL ratio:</strong> ${env.TPUT_RATIO ?: '—'}</p>
                    <p><strong>Duration:</strong> ${env.TPUT_SECONDS ?: '—'}s per run</p>
                    <p><strong>SU count:</strong> ${env.TPUT_SU ?: '—'}</p>
                    <p><strong>TRex server:</strong> ${env.TPUT_TREX ?: '—'}</p>
                """

                try {
                    senao.sendSenaoPipelineEmail([
                        subjectPrefix: 'UBR Performance Throughput',
                        reportTitle: 'UBR Performance Throughput Report',
                        footerNote: 'TRex throughput per MCS',
                        reportFile: hasReport ? reportFile : '',
                        detailsHtml: detailsHtml
                    ])
                } catch (Exception exc) {
                    echo "Email notification failed: ${exc.message}"
                }
                echo '-----------------------------------------'
                echo 'Throughput pipeline complete.'
                echo "Report: ${hasReport ? reportFile : 'not generated'}"
                echo '-----------------------------------------'
            }
        }
    }
}
