// Report: Senao_Performance_<build>_Report_<date>.html

def archiveBuildArtifacts(pattern, allowEmpty = false) {
    step([
        $class: 'ArtifactArchiver',
        artifacts: pattern,
        fingerprint: true,
        onlyIfSuccessful: false,
        allowEmptyArchive: allowEmpty,
    ])
}

def selectedValues(String paramName, List order) {
    def raw = params[paramName]
    def text = raw == null ? '' : raw.toString()
    text = text.replace('[', '').replace(']', '')
    def picked = text.split(',').collect { it.toString().trim() }.findAll { it }
    // Interpolated names such as "MCS${n}" are GStrings. List.contains uses
    // equals(), and a GString is not equal to the String Jenkins submits.
    def allowed = order.collect { it.toString() }
    def unknown = picked.findAll { !allowed.contains(it) }
    if (!unknown.isEmpty()) {
        error("Unknown ${paramName}: ${unknown.join(', ')}")
    }
    return allowed.findAll { picked.contains(it) }
}

def wholeNumber(String name) {
    def text = (params[name] ?: '').toString().trim()
    if (!(text ==~ /[1-9][0-9]*/)) {
        error("${name} must be a whole number, 1 or more.")
    }
    return text
}

