// UBR TRex performance matrix — runs on TARGET_STAND agent (same as GUI automation jobs).
// Generates logs/Performance_Report_<timestamp>.html and emails the triggering user.

def archiveArtifacts(pattern) {
    step([$class: 'ArtifactArchiver', artifacts: pattern, fingerprint: true, onlyIfSuccessful: false])
}

def resolveUserEmail() {
    def buildCauses = currentBuild.getBuildCauses()
    def userCause = buildCauses.find { it._class == 'hudson.model.Cause$UserIdCause' }
    def buildUserId = userCause?.userId ?: 'unknown'
    def userEmails = [
        'puneet': 'puneet.sharma@senao.com',
        'harman': 'harmanjot.singh@senao.com',
        'mahesh': 'mahesh.battala@senao.com',
        'sandeep': 'sandeep.manchikanti@senao.com',
        'sampath': 'sampath.marella@senao.com',
        'jayanth': 'jayanth.munnaluru@senao.com',
        'srilatha': 'srilatha.tadiboina@senao.com',
        'phani': 'phani.darla@senao.com',
        'dinesh': 'dinesh.redddy@senao.com'
    ]
    return [
        name: userCause?.userName ?: 'Unknown User',
        id: buildUserId,
        email: userEmails.get(buildUserId, 'harmanjot.singh@senao.com')
    ]
}

def sendBuildEmail(String reportFile, boolean hasReport) {
    def user = resolveUserEmail()
    def dateStr = new Date().format('dd MMM yyyy, HH:mm:ss z', TimeZone.getTimeZone('Asia/Kolkata'))
    def resultColor = currentBuild.currentResult == 'SUCCESS' ? 'green' : 'orange'
    def reportSection = hasReport
        ? """<p><strong>HTML report:</strong>
            <a href="${env.BUILD_URL}artifact/${reportFile}">Download detailed report</a>
            &nbsp;|&nbsp;
            <a href="${env.BUILD_URL}">Open build in Jenkins</a></p>"""
        : """<p><strong>HTML report:</strong> not generated.
            Check the <a href="${env.BUILD_URL}console">build console</a>.</p>"""

    def mailParams = [
        subject: "UBR Performance Throughput — ${currentBuild.fullDisplayName} — ${currentBuild.currentResult}",
        body: """\
            <html><body style="font-family:Segoe UI,sans-serif;color:#334155;">
                <h2 style="color:#1e3a8a;">UBR Performance Throughput Report</h2>
                <p><strong>Build:</strong> ${currentBuild.fullDisplayName}</p>
                <p><strong>Status:</strong> <span style="color:${resultColor};">${currentBuild.currentResult}</span></p>
                <p><strong>Started by:</strong> ${user.name} (${user.id})</p>
                <p><strong>Time:</strong> ${dateStr}</p>
                <p><strong>Target stand:</strong> ${TARGET_STAND}</p>
                <hr/>
                <p><strong>BTS IP:</strong> ${params['BTS IP'] ?: '(profile default)'}</p>
                <p><strong>CPE IP:</strong> ${params['CPE IP'] ?: '(profile default)'}</p>
                <p><strong>Bandwidth:</strong> ${params.Bandwidth}</p>
                <p><strong>MCS:</strong> ${params.MCS}</p>
                <p><strong>Packet size:</strong> ${params['Packet Size']} bytes</p>
                <p><strong>DL:UL ratio:</strong> ${params['DL:UL Ratio']}</p>
                <p><strong>Duration:</strong> ${params['Throughput Test Time']}s per iteration</p>
                ${reportSection}
                <p style="color:#64748b;font-size:12px;">Senao UBR Automation — TRex performance matrix</p>
            </body></html>
        """,
        to: user.email,
        mimeType: 'text/html'
    ]
    if (hasReport) {
        mailParams.attachmentsPattern = reportFile
    }
    emailext(mailParams)
}

pipeline {
    agent { node { label "${TARGET_STAND}" } }

    parameters {
        string(
            name: 'BTS IP',
            defaultValue: '',
            description: 'BTS (local DUT) IPv4/IPv6. Leave empty to use profile default (profiles/default.yaml)'
        )
        string(
            name: 'CPE IP',
            defaultValue: '',
            description: 'CPE (remote SU) IPv4/IPv6. Leave empty to use profile default'
        )
        string(
            name: 'Bandwidth',
            defaultValue: 'HT80',
            description: 'Comma-separated htmode values (e.g. HT20,HT40,HT80,HT160)'
        )
        string(
            name: 'MCS',
            defaultValue: 'MCS23',
            description: 'Comma-separated MCS values (e.g. MCS19,MCS23)'
        )
        string(
            name: 'Packet Size',
            defaultValue: '1500',
            description: 'TRex frame size in bytes (default 1500 from config/defaults.py)'
        )
        string(
            name: 'DL:UL Ratio',
            defaultValue: '75:25',
            description: 'Bidirectional DL:UL ratio for throughput run (default 75:25)'
        )
        string(
            name: 'Throughput Test Time',
            defaultValue: '30',
            description: 'TRex measurement duration per iteration (seconds)'
        )
        string(
            name: 'TRex Server',
            defaultValue: '192.168.3.3',
            description: 'TRex host IP (default from config/defaults.py)'
        )
    }

    stages {
        stage('Prepare Testbed') {
            steps {
                script {
                    echo '------------------------------------------'
                    echo 'UBR Performance Throughput (TRex matrix)'
                    echo "--- TARGET STAND: ${TARGET_STAND}"
                    echo "BTS IP:     ${params['BTS IP'] ?: '(profile default)'}"
                    echo "CPE IP:     ${params['CPE IP'] ?: '(profile default)'}"
                    echo "Bandwidth:  ${params.Bandwidth}"
                    echo "MCS:        ${params.MCS}"
                    echo "Packet:     ${params['Packet Size']}"
                    echo "Ratio:      ${params['DL:UL Ratio']}"
                    echo "Duration:   ${params['Throughput Test Time']}s"
                    echo "TRex:       ${params['TRex Server']}"
                    echo '------------------------------------------'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    python3 -m pip install --upgrade pip
                    python3 -m pip install -r requirements.txt
                '''
            }
        }

        stage('Run Performance Matrix') {
            steps {
                script {
                    def btsIp = (params['BTS IP'] ?: '').trim()
                    def cpeIp = (params['CPE IP'] ?: '').trim()
                    def bandwidths = (params.Bandwidth ?: 'HT80').trim()
                    def mcsList = (params.MCS ?: 'MCS23').trim()
                    def ratio = (params['DL:UL Ratio'] ?: '75:25').trim()
                    def testTime = (params['Throughput Test Time'] ?: '30').trim()
                    def trexServer = (params['TRex Server'] ?: '192.168.3.3').trim()
                    def packetRaw = (params['Packet Size'] ?: '1500').trim()
                    if (!(packetRaw ==~ /^\d+$/)) {
                        error("Packet Size must be numeric bytes (e.g. 1500), got: ${packetRaw}")
                    }

                    sh 'rm -rf logs/performance_* logs/Performance_Report_*.html || true'

                    def cmd = new StringBuilder('PYTHONPATH=. python3 traffic/performance_matrix.py')
                    cmd.append(" --bandwidths '${bandwidths}'")
                    cmd.append(" --mcs '${mcsList}'")
                    cmd.append(" --ratios '${ratio}'")
                    cmd.append(' --ratios-only')
                    cmd.append(" --time ${testTime}")
                    cmd.append(" --packet-size ${packetRaw}")
                    cmd.append(" --trex-server '${trexServer}'")
                    cmd.append(' --deploy-client-script')
                    if (btsIp) {
                        cmd.append(" --local-ip '${btsIp}'")
                    }
                    if (cpeIp) {
                        cmd.append(" --cpe-ip '${cpeIp}'")
                    }

                    def exitCode = sh(script: cmd.toString(), returnStatus: true)
                    env.PERF_MATRIX_EXIT = "${exitCode}"

                    def reportPath = sh(
                        script: 'ls -t logs/Performance_Report_*.html 2>/dev/null | head -1',
                        returnStdout: true
                    ).trim()
                    if (!reportPath) {
                        error('Performance matrix finished but no HTML report found under logs/')
                    }
                    env.PERFORMANCE_REPORT = reportPath
                    echo "HTML report: ${reportPath}"
                    if (exitCode != 0) {
                        unstable("Performance matrix completed with failures (exit ${exitCode})")
                    }
                }
            }
        }

        stage('Archive Report') {
            steps {
                archiveArtifacts 'logs/Performance_Report_*.html'
                archiveArtifacts 'logs/performance_*/**,allowEmptyArchive:true'
            }
        }
    }

    post {
        always {
            script {
                def reportFile = env.PERFORMANCE_REPORT ?: ''
                def hasReport = reportFile && fileExists(reportFile)
                if (hasReport) {
                    def reportName = reportFile.tokenize('/').last()
                    publishHTML(target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'logs',
                        reportFiles: reportName,
                        reportName: "Performance Report - Build ${env.BUILD_NUMBER}"
                    ])
                }
                try {
                    sendBuildEmail(reportFile, hasReport)
                } catch (Exception exc) {
                    echo "Email notification failed: ${exc.message}"
                }
                echo '-----------------------------------------'
                echo 'Throughput pipeline complete.'
                echo "Report: ${reportFile ?: 'not generated'}"
                echo '-----------------------------------------'
            }
        }
    }
}
